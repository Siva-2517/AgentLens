# Database Configuration (Neon PostgreSQL)
# Format: postgresql://[user]:[password]@[endpoint]/[dbname]?sslmode=require
DATABASE_URL=postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/agentlens?sslmode=require

# Redis Configuration (Local Docker or Redis Cloud / Managed Clusters)
# Local: redis://localhost:6379/0
# Redis Cloud (Standard): redis://default:YOUR_PASSWORD@redis-12345.c123.us-east-1-1.ec2.redns.redis-cloud.com:12345
# Redis Cloud (TLS):     rediss://default:YOUR_PASSWORD@redis-12345.c123.us-east-1-1.ec2.redns.redis-cloud.com:12345
REDIS_URL=redis://localhost:6379/0

# API Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# Application Environment: 'development' or 'production'
# In 'production', fail-closed validation enforces strict JWT entropy, HTTPS cookies, and disallows dev keys.
ENVIRONMENT=development

# Authentication & Session Security (Phase 19B & 20B)
# In production: MUST be set to a cryptographically random secret with at least 32 characters and high entropy.
# Example generator: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=your_high_entropy_jwt_secret_key_minimum_32_chars_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Cookie Security (Enforce HTTPS in production)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# CORS Configuration
# In production: must be explicit HTTPS origins (e.g. https://dashboard.yourdomain.com). Wildcards '*' are prohibited.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Legacy Development API Keys (Development/Testing Only)
# Leave EMPTY or unset in production. Production uses project-specific hashed API keys (al_live_...).
AGENTLENS_API_KEYS=test_api_key_123,dev_key

# Model Context Protocol (MCP) Client Credential
# Set in MCP client environment (e.g. Claude Desktop, Cursor) with a project-scoped key:
# AGENTLENS_API_KEY=al_live_your_project_key_here

# LLM & Embedding Providers
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Application Settings
LOG_LEVEL=INFO
MAX_EVENT_BATCH_SIZE=1000
SQL_ECHO=false

# Deployment Topology & Operational Readiness (Phase 20D)
# 'single-instance' allows degraded in-memory pub/sub when Redis is unavailable.
# 'multi-instance' enforces REDIS_REQUIRED=true and returns 503 if Redis is disconnected.
DEPLOYMENT_TOPOLOGY=single-instance
REDIS_REQUIRED=false

# Provider Mock Restriction (Phase 20D)
# MUST remain 'false' in production. Setting to 'true' permits mock LLM and embedding providers.
ALLOW_MOCK_PROVIDERS=false

# Operational Metrics Protection (Phase 20D)
# Leave empty for internal scraper networks or set a bearer token for protected scraping.
METRICS_ENABLED=true
METRICS_AUTH_TOKEN=

# =============================================================================
# 2. FRONTEND DASHBOARD LINK TO BACKEND (frontend/.env)
# =============================================================================
# These variables configure how the React frontend links to the backend API:
#
# Unified domain / Reverse-proxy deployment (e.g. https://yourdomain.com/api/v1):
# VITE_API_BASE_URL=/api/v1
#
# Separate frontend domain (e.g. Vercel) linking to backend:
# VITE_API_BASE_URL=https://api.yourdomain.com/api/v1
# VITE_WS_BASE_URL=wss://api.yourdomain.com/api/v1/ws/traces

# =============================================================================
# 3. AGENTLENS PYTHON SDK / AGENT INGESTION SIDE (demo/ or external AI agents)
# =============================================================================
# These variables configure how your AI agents send telemetry to the AgentLens API:
#
# AGENTLENS_API_URL=https://api.yourdomain.com
# AGENTLENS_API_KEY=al_live_your_project_key_created_in_dashboard
# AGENTLENS_PROJECT_NAME=my-ai-agent

# =============================================================================
# 4. MODEL CONTEXT PROTOCOL (MCP) CLIENT (Cursor / Claude Desktop)
# =============================================================================
# Configure in Claude Desktop or Cursor configuration:
# AGENTLENS_API_KEY=al_live_your_project_key_with_mcp_scope
# AGENTLENS_API_URL=https://api.yourdomain.com

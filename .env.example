# Database Configuration
# Use your Neon PostgreSQL connection string
# Get it from: https://console.neon.tech
# Format: postgresql://[user]:[password]@[endpoint]/[dbname]?sslmode=require
DATABASE_URL=postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/agentlens?sslmode=require

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# LLM Provider API Keys
# Get Gemini API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Get Groq API key from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Application Settings
LOG_LEVEL=INFO
ENVIRONMENT=development

# API Key Configuration
# Comma-separated list of valid API keys
# In development, use: test_api_key_123 or dev_key
AGENTLENS_API_KEYS=test_api_key_123,dev_key

# Security Configuration (Phase 17)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
MAX_EVENT_BATCH_SIZE=1000
SQL_ECHO=false

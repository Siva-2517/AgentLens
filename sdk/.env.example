# =============================================================================
# AgentLens Python SDK — Client Configuration Template
# =============================================================================
# Configure these variables in your AI agent process environment to automatically
# initialize the AgentLens telemetry client.

# -----------------------------------------------------------------------------
# 1. Backend Ingestion Link
# -----------------------------------------------------------------------------
# Local development:
AGENTLENS_API_URL=http://localhost:8000
# Production / Staging deployment:
# AGENTLENS_API_URL=https://api.yourdomain.com

# -----------------------------------------------------------------------------
# 2. Authentication & Multi-Tenancy
# -----------------------------------------------------------------------------
# Ingestion API key generated from the AgentLens dashboard (al_live_...):
# (In local development test mode only, 'test_api_key_123' can be used)
AGENTLENS_API_KEY=al_live_your_project_ingestion_key_here

# Target project name for telemetry isolation:
AGENTLENS_PROJECT_NAME=customer-support-agent

# -----------------------------------------------------------------------------
# 3. Telemetry Controls (Optional)
# -----------------------------------------------------------------------------
AGENTLENS_ENABLED=true
AGENTLENS_FLUSH_INTERVAL=5
AGENTLENS_BATCH_SIZE=100
AGENTLENS_TIMEOUT=5

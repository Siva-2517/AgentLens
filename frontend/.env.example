# AgentLens Frontend Environment Configuration
# This file is used during `npm run build` or `npm run dev` to configure backend links.

# -----------------------------------------------------------------------------
# 1. API Link (How frontend talks to backend REST API)
# -----------------------------------------------------------------------------
# Option A: Unified Domain / Reverse Proxy (Recommended for production):
# When frontend and backend share the same domain (e.g. Nginx, Cloudflare, Traefik)
# where `/api/v1` routes to the backend:
VITE_API_BASE_URL=/api/v1

# Option B: Cross-Domain Deployment:
# When frontend is on Vercel/Netlify (e.g. https://dashboard.yourdomain.com)
# and backend is on Render/Cloud Run (e.g. https://api.yourdomain.com):
# VITE_API_BASE_URL=https://api.yourdomain.com/api/v1

# -----------------------------------------------------------------------------
# 2. WebSocket Link (How frontend connects to real-time trace stream)
# -----------------------------------------------------------------------------
# Optional: If omitted, the frontend automatically derives `wss://` or `ws://`
# from VITE_API_BASE_URL or window.location.
# Set explicitly only if your WebSocket endpoint uses a custom domain/path:
# VITE_WS_BASE_URL=wss://api.yourdomain.com/api/v1/ws/traces

# =============================================================================
# AgentLens Backend Service — Environment Configuration Template
# =============================================================================
# Copy this file to `backend/.env` for local execution or configure these
# environment variables in your cloud hosting provider (e.g. Render, Railway, Cloud Run).

# -----------------------------------------------------------------------------
# 1. Database Configuration (Neon Cloud PostgreSQL with pgvector)
# -----------------------------------------------------------------------------
# Format: postgresql://[user]:[password]@[endpoint]/[dbname]?sslmode=require
# In production: TLS/SSL is strictly enforced (sslmode=require or verify-full).
DATABASE_URL=postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/agentlens?sslmode=require

# -----------------------------------------------------------------------------
# 2. Redis Configuration (Redis Cloud / Managed Cluster)
# -----------------------------------------------------------------------------
# Local Docker: redis://localhost:6379/0
# Redis Cloud (Standard): redis://default:YOUR_PASSWORD@redis-12345.c123.us-east-1-1.ec2.redns.redis-cloud.com:12345
# Redis Cloud (TLS):     rediss://default:YOUR_PASSWORD@redis-12345.c123.us-east-1-1.ec2.redns.redis-cloud.com:12345
# In production: REDIS_URL cannot point to localhost/127.0.0.1 when Redis is required.
REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# 3. API Server Configuration
# -----------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# -----------------------------------------------------------------------------
# 4. Environment & Security Mode
# -----------------------------------------------------------------------------
# Options: 'development' or 'production'
# In 'production': fail-closed validation enforces JWT entropy, HTTPS-only cookies,
# non-mock providers, and blocks legacy dev keys.
ENVIRONMENT=development

# -----------------------------------------------------------------------------
# 5. Authentication & Session Security (JWT & Cookies)
# -----------------------------------------------------------------------------
# In production: MUST be set to a cryptographically random secret (>= 32 chars, high entropy).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=your_high_entropy_jwt_secret_key_minimum_32_chars_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Cookie Security (MUST be 'true' in production with HTTPS)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# -----------------------------------------------------------------------------
# 6. CORS Configuration
# -----------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins.
# In production: Wildcard '*' and 'http://' are forbidden; must be explicit HTTPS URLs.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# -----------------------------------------------------------------------------
# 7. Legacy API Keys (Development/Testing Only)
# -----------------------------------------------------------------------------
# Leave EMPTY or unset in production. Production uses project-scoped hashed keys (al_live_...).
AGENTLENS_API_KEYS=test_api_key_123,dev_key

# -----------------------------------------------------------------------------
# 8. LLM & Embedding Providers
# -----------------------------------------------------------------------------
# Root-cause investigation provider:
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
LLM_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.0
INVESTIGATION_TIMEOUT_SECONDS=30.0

# Failure embedding provider (Phase 15: pgvector semantic search):
EMBEDDING_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
EMBEDDING_MODEL=models/text-embedding-004
EMBEDDING_DIMENSION=768

# Mock Provider Prohibition:
# MUST be 'false' in production. Setting to 'true' permits mock LLM and embedding providers.
ALLOW_MOCK_PROVIDERS=false

# -----------------------------------------------------------------------------
# 9. Deployment Topology & Operational Readiness
# -----------------------------------------------------------------------------
# Options: 'single-instance' or 'multi-instance'
# 'single-instance': allows degraded in-memory pub/sub when Redis is unavailable.
# 'multi-instance': enforces REDIS_REQUIRED=true and returns 503 if Redis is disconnected.
DEPLOYMENT_TOPOLOGY=single-instance
REDIS_REQUIRED=false

# Operational Prometheus/OpenTelemetry Metrics:
METRICS_ENABLED=true
METRICS_AUTH_TOKEN=

# -----------------------------------------------------------------------------
# 10. Application & Logging Settings
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
MAX_EVENT_BATCH_SIZE=1000
SQL_ECHO=false
